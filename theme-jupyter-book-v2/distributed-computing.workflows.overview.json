e params class\n    cli_params = Params()\n\n    # Register simple on/off switches\n    Script.registerSwitch('w', 'wms', 'Run on DIRAC WMS',\n                          cli_params.run_on_wms)\n    Script.registerSwitch('l', 'local', 'Run locally',\n                          cli_params.run_locally)\n\n    # Parse the command line and initialize DIRAC\n    Script.parseCommandLine()\n\n    # The result of the command line parsing is stored in the params class\n    gLogger.notice('cli_params.where: ', cli_params.where)\n\n\nif __name__ == '__main__':\n    main()","position":{"start":{"line":33,"column":1},"end":{"line":68,"column":1}},"key":"hZq3VRoyEn"},{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"The DIRAC interface is controlled by the API interface class ","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"rgKAHHPobe"},{"type":"inlineCode","value":"DiracILC","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"HB0rRY0frI"},{"type":"text","value":", which\nderives from the upstream ","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"v672Kr84n3"},{"type":"link","url":"https://github.com/DIRACGrid/DIRAC/blob/integration/src/DIRAC/Interfaces/API/Dirac.py","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"DIRAC API","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"n5xMPnv8bm"}],"urlSource":"https://github.com/DIRACGrid/DIRAC/blob/integration/src/DIRAC/Interfaces/API/Dirac.py","data":{"kind":"file","org":"DIRACGrid","repo":"DIRAC","reference":"integration","file":"src/DIRAC/Interfaces/API/Dirac.py","raw":"https://raw.githubusercontent.com/DIRACGrid/DIRAC/integration/src/DIRAC/Interfaces/API/Dirac.py"},"internal":false,"protocol":"github","key":"RKTwr13DFX"},{"type":"text","value":". Typical usage is the following:","