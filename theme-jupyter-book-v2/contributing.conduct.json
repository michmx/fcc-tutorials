{"version":3,"kind":"Article","sha256":"1f81839af0af10daf5141b8da5f3e0b244006a5ba404bca2cd6b3176e6cad53c","slug":"contributing.conduct","location":"/7-contributing/CONDUCT.md","dependencies":[],"frontmatter":{"title":"Contributor Code of Conduct","content_includes_title":false,"github":"https://github.com/HEP-FCC/fcc-tutorials","numbering":{"title":{"enabled":true,"offset":1}},"copyright":"2026, CERN","source_url":"https://github.com/HEP-FCC/fcc-tutorials/blob/main/7-contributing/CONDUCT.md","edit_url":"https://github.com/HEP-FCC/fcc-tutorials/edit/main/7-contributing/CONDUCT.md","enumerator":"7.1","exports":[{"format":"md","filename":"CONDUCT.md","url":"/fcc-tutorials/theme-jupyter-book-v2/build/CONDUCT-c9f9376efc61ea8c58df7ee45fce5fe0.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"As contributors and maintainers of this project, we pledge to respect all people who contribute through reporting issues, posting feature requests, updating documentation, submitting pull requests or patches, and other activities.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GBft6V5LF0"}],"key":"JbuxKIBnni"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We are committed to making participation in this project a harassment-free experience for everyone, regardless of level of experience, gender, gender identity and expression, sexual orientation, disability, personal appearance, body size, race, ethnicity, age, or religion.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Ra5O7SW8zE"}],"key":"THSbfSe5sX"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Examples of unacceptable behaviour by participants include the use of sexual language or imagery, derogatory comments or personal attacks, trolling, public or private harassment, insults, or other unprofessional conduct.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"TjmaORtbeH"}],"key":"yZDVXpPYhl"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Project maintainers have the right and responsibility to remove, edit, or reject comments, commits, code, wiki edits, issues, and other contributions that are not aligned to this Code of Conduct. Project maintainers who do not follow the Code of Conduct may be removed from the project team.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"MvYkneMYaT"}],"key":"DQH7U06UrF"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Instances of abusive, harassing, or otherwise unacceptable behaviour may be reported by opening an issue or contacting one or more of the project maintainers.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"vw4o0brP4k"}],"key":"s9yO2Q0f3d"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"This Code of Conduct is adapted from the ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"oysLCo9Xwc"},{"type":"link","url":"https://www.contributor-covenant.org/","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Contributor Covenant","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"zLqF3ysZVo"}],"urlSource":"https://www.contributor-covenant.org/","key":"vr4rnfkOyg"},{"type":"text","value":", version 1.0.0, available at ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"yYR9lwSinf"},{"type":"link","url":"https://